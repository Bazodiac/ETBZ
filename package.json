{
  "name": "etbz-service",
  "version": "0.1.0",
  "private": true,
  "description": "ETBZ service foundation (ETBZ-9): liveness, configuration readiness, architecture boundaries. No business pipeline.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "attest:fufire": "node dist/attest-fufire.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:negative": "vitest run tests/negative",
    "test:contract": "vitest run tests/contract",
    "test:architecture": "vitest run tests/architecture",
    "guards": "bash scripts/verify-guards.sh",
    "guards:etbz34": "node scripts/verify-etbz34-mutations.mjs",
    "guards:etbz30a": "node scripts/verify-etbz30a-mutations.mjs",
    "guards:etbz30b": "node scripts/verify-etbz30b-mutations.mjs",
    "guards:etbz49": "node scripts/verify-etbz49-visual-system.mjs",
    "guards:etbz51": "node scripts/verify-etbz51-skill-contract-bundle.mjs",
    "guards:etbz52": "node scripts/verify-etbz52-skill-reading.mjs",
    "guards:etbz55": "node scripts/verify-etbz55-presentation.mjs",
    "etbz49:contract": "node scripts/etbz49-generate-visual-contract.mjs",
    "etbz49:assemble": "node scripts/etbz49-assemble-evidence.mjs",
    "etbz51:bundle": "node scripts/etbz51-print-bundle.mjs",
    "etbz52:package": "node scripts/etbz52-skill-package.mjs",
    "etbz52:manifest": "node scripts/etbz52-fixture-manifest.mjs",
    "etbz55:metrics": "node scripts/etbz55-generate-font-metrics.mjs",
    "etbz55:projection": "vite-node tests/support/emit-etbz55-projection.ts",
    "secret-scan": "bash scripts/secret-scan.sh",
    "deps:scan": "npm audit --audit-level=high --omit=dev",
    "build-dry-run": "bash scripts/build-dry-run.sh",
    "verify": "bash scripts/ci-verify.sh"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.9.1",
    "js-yaml": "^4.1.0",
    "supertest": "^7.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  }
}
